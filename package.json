  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "publish:hostinger": "node scripts/publish-hostinger.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/optimize-assets.mjs && node scripts/build-hero-products.mjs && node scripts/build-hero-plate.mjs && node scripts/build-ingredient-art.mjs && node scripts/build-intro-art.mjs && node scripts/extract-accents.mjs && node scripts/extract-bottle-profile.mjs && node scripts/unwrap-labels.mjs && node scripts/trace-logo.mjs",
    "lh:mobile": "lighthouse --chrome-flags=\"--headless=new --disable-gpu --disable-features=CalculateNativeWinOcclusion\" --only-categories=performance,accessibility,best-practices,seo --view",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lenis": "1.3.27",
    "lucide-react": "1.67.0",
    "motion": "14.9.0",
